# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://pxpciotofcwvhjcodktu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Server-only secrets (never commit real values; add them in Vercel → Settings → Environment Variables)
# Supabase → Project Settings → API Keys → Secret key
SUPABASE_SECRET_KEY=
# Razorpay Dashboard (Test mode) → Account & Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Resend (resend.com) → API Keys. Optional: without it, booking emails are skipped.
RESEND_API_KEY=
# Optional sender. The default onboarding@resend.dev only delivers to your own Resend account email.
EMAIL_FROM=
